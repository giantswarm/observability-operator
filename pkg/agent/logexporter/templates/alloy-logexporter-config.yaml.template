# This file was generated by observability-operator.
# It configures Alloy to archive selected logs to a destination outside the platform.
#
# - configMap is generated from alloy-logexporter.alloy.template and passed as a string here;
#   Alloy's chart creates the ConfigMap from it.
# - Alloy runs as a statefulset because otelcol.storage.file needs per-replica persistent
#   storage: it is the write-ahead log that carries buffered records through a destination
#   outage and across a pod restart.
# - alloy.enabled turns the app on; it ships disabled, which is what keeps it inert on
#   installations with no LogExport.
alloy:
  enabled: true

  # POD-level security context lives under `global`, not `controller` and not alongside
  # the container securityContext -- the pod template reads
  # `.Values.global.podSecurityContext`, so anywhere else silently does nothing. The
  # container runs as {{ .RunAsUser }} but a freshly provisioned PVC is root-owned, so
  # without fsGroup Alloy fails to build otelcol.storage.file with
  # `mkdir {{ .WALDirectory }}: permission denied`.
  global:
    podSecurityContext:
      fsGroup: {{ .RunAsUser }}

  controller:
    type: statefulset
    replicas: {{ .Replicas }}
    volumeClaimTemplates:
      - metadata:
          name: wal
        spec:
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              # Size for rate x timeout, not for throughput: this only has to hold what
              # accumulates while the destination is unavailable.
              storage: "{{ .WALSize }}"

  alloy:
    # otelcol.exporter.awss3 is experimental and otelcol.storage.file is in public
    # preview; Alloy refuses to load the config without this.
    stabilityLevel: experimental

    # ephemeral-storage is required by the require-emptydir-requests-and-limits Kyverno
    # policy, because the container mounts the alloy-tmp emptyDir.
    resources:
      {{- toYaml .Resources | nindent 6 }}

    # The chart's Service exposes only the 12345 metrics port, so the push endpoint has to
    # be added explicitly -- `extraPorts` puts it on both the container and the Service.
    # Without this the mirror backendRef resolves to a Service with no such port and every
    # mirrored request fails.
    extraPorts:
      - name: push
        port: {{ .Port }}
        targetPort: {{ .Port }}
        protocol: TCP

    # `mounts.extra` REPLACES the chart default rather than adding to it, so the chart's
    # own alloy-tmp entry has to be restated here. Without it Alloy crashes with
    # `mkdir /tmp/alloy: read-only file system`, because --storage.path defaults to
    # /tmp/alloy and readOnlyRootFilesystem is on.
    mounts:
      extra:
        - name: alloy-tmp
          mountPath: /tmp/alloy
        - name: wal
          mountPath: {{ .WALMountPath }}

    configMap:
      create: true
      content: |-
        {{ .AlloyConfig | nindent 8 | replace "        \n" "" | trim }}

    # The destination credentials are NOT here: they arrive as a separate valuesFrom
    # Secret carrying extraSecretEnv, which alloy-app turns into a Secret named after the
    # release.
    #
    # That Secret has to reach the container as environment variables, because the awss3
    # exporter has no credential fields -- it uses the AWS SDK's default chain. This is
    # unlike the other collectors, whose credentials are read from a Secret at runtime by
    # `remote.kubernetes.secret` and so never need to be in the environment.
    #
    # optional: true so the release still starts when no credentials Secret exists, which
    # is the case when the destination is reached with IRSA instead.
    envFrom:
      - secretRef:
          name: {{ .AppName }}
          optional: true

# Cilium denies all egress when the rules are empty, so the exporter needs explicit
# permission to reach DNS and the destination.
networkPolicy:
  flavor: cilium
  cilium:
    # The chart's DEFAULT ingress allows port 12345 only, so without this the push
    # endpoint is unreachable and every mirrored request fails -- silently, because
    # Envoy's mirror is fire-and-forget. Setting `ingress` replaces the default wholesale,
    # so 12345 has to be restated or metrics scraping breaks.
    ingress:
      # Prometheus scraping (the chart default, restated)
      - toPorts:
          - ports:
              - port: "12345"
                protocol: TCP
      # Mirrored Loki pushes from the Envoy gateway
      - fromEndpoints:
          - matchLabels:
              io.kubernetes.pod.namespace: envoy-gateway-system
        toPorts:
          - ports:
              - port: "{{ .Port }}"
                protocol: TCP
    egress:
      - toEntities:
          - kube-apiserver
          - cluster
          - world
      - toEndpoints:
          - matchLabels:
              k8s-app: coredns
          - matchLabels:
              k8s-app: k8s-dns-node-cache
        toPorts:
          - ports:
              - port: "1053"
                protocol: UDP
              - port: "1053"
                protocol: TCP
              - port: "53"
                protocol: UDP
              - port: "53"
                protocol: TCP

kyvernoPolicyExceptions:
  enabled: true
