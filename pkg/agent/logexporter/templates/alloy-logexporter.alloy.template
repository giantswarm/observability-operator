// This file was generated by observability-operator.
//
// Receives Loki push requests mirrored off the write path by an Envoy
// HTTPRequestMirrorFilter and archives the selected lines to object storage.
//
// Requires --stability.level=experimental: otelcol.exporter.awss3 is experimental
// and otelcol.storage.file is in public preview.
loki.source.api "mirror" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = {{ .Port }}
	}
	forward_to = [
{{- range .Exports }}
		loki.process.select_{{ .Slug }}.receiver,
{{- end }}
	]
}
otelcol.storage.file "wal" {
	directory = "{{ .WALDirectory }}"
}
{{- range .Exports }}

// {{ .Ref }}
//
// Selection is expressed as a DROP of the negated selector. stage.match with the default
// action = "keep" does NOT drop non-matching entries -- it only gates its nested stages --
// and it fails validation without one. Emitting one drop stage per negated term composes
// as an AND of keeps.
loki.process "select_{{ .Slug }}" {
{{- range .Pipeline.StreamDrops }}
	stage.match {
		selector            = {{ . | quote }}
		action              = "drop"
		drop_counter_reason = "not_selected"
	}
{{- end }}
{{- if .Pipeline.JSONFields }}
	// A label filter matches on labels, so the fields it names have to be extracted from
	// the line and promoted first. An entry whose field is missing gets an empty label and
	// is dropped by the match below: not exporting a line we cannot evaluate is the safe
	// direction, since the alternative is exporting more than the customer asked for.
	stage.json {
		expressions = { {{ range $i, $f := .Pipeline.JSONFields }}{{ if $i }}, {{ end }}{{ $f | quote }} = {{ $f | quote }}{{ end }} }
	}
	stage.labels {
		values = { {{ range $i, $f := .Pipeline.JSONFields }}{{ if $i }}, {{ end }}{{ $f | quote }} = ""{{ end }} }
	}
{{- range .Pipeline.FieldDrops }}
	stage.match {
		selector            = {{ . | quote }}
		action              = "drop"
		drop_counter_reason = "field_not_selected"
	}
{{- end }}
{{- end }}
	forward_to = [otelcol.receiver.loki.to_{{ .Slug }}.receiver]
}
otelcol.receiver.loki "to_{{ .Slug }}" {
	output {
		logs = [otelcol.processor.transform.inject_{{ .Slug }}.input]
	}
}
// A Kubernetes audit event carries no cluster identifier of its own, and the `body`
// marshaler writes only the log line, dropping every Loki label. Without this the archive
// cannot be attributed to a cluster.
//
// The statement drops the closing brace and appends a field, so it is guarded to run only
// on a JSON object. A selector may legitimately match a stream that is not JSON -- plain
// application logs, for one -- and without the guard such a line loses its last character
// and gains a JSON fragment. Nothing errors: the surgery simply succeeds on the wrong
// input. A line that is not an object passes through unchanged and carries no cluster id,
// which is the honest outcome, since it has nowhere to put one.
otelcol.processor.transform "inject_{{ .Slug }}" {
	error_mode = "ignore"
	log_statements {
		context = "log"
		statements = [
			`set(log.body, Concat([Substring(log.body, 0, Len(log.body) - 1), ",\"{{ $.ClusterIDField }}\":\"", log.attributes["cluster_id"], "\"}"], "")) where IsMatch(log.body, "^\\{.*\\}$")`,
		]
	}
	output {
		logs = [otelcol.exporter.awss3.{{ .Slug }}.input]
	}
}
otelcol.exporter.awss3 "{{ .Slug }}" {
	// This exporter does not expose retry_on_failure and it is disabled, so `timeout` is
	// the durability window: an object-store outage longer than this loses data
	// permanently, whatever the queue holds.
	timeout = "{{ $.ExportTimeout }}"
	marshaler {
		// Raw log lines, newline-delimited -- directly queryable as NDJSON.
		type = "body"
	}
	sending_queue {
		enabled = true
		storage = otelcol.storage.file.wal.handler
		// The queue sits before the batcher and holds one entry per Loki entry. The
		// defaults (sizer = "requests", queue_size = 1000, block_on_overflow = false) are
		// well under a second of buffer at installation scale and drop silently, visible
		// only in otelcol_exporter_enqueue_failed_log_records_total.
		sizer             = "items"
		queue_size        = {{ $.QueueSize }}
		block_on_overflow = true
		num_consumers     = {{ $.QueueConsumers }}
		// Mandatory. otelcol.receiver.loki calls ConsumeLogs once per entry, so without
		// batching every single log line becomes its own object.
		batch {
			sizer         = "items"
			min_size      = {{ $.BatchMinSize }}
			max_size      = {{ $.BatchMaxSize }}
			flush_timeout = "{{ $.BatchFlushTimeout }}"
		}
	}
	s3_uploader {
		region                = {{ .S3.Region | quote }}
		s3_bucket             = {{ .S3.Bucket | quote }}
		// Required by the exporter even though the CRD's prefix is optional: omitting the
		// attribute fails the config load, which would stop every export on the
		// installation. Empty means objects start at the bucket root.
		s3_prefix             = {{ .S3.Prefix | quote }}
{{- if .S3.Endpoint }}
		endpoint              = {{ .S3.Endpoint | quote }}
{{- end }}
{{- if .S3.ForcePathStyle }}
		s3_force_path_style   = true
{{- end }}
{{- if .S3.RoleARN }}
		// Cross-account delivery: the exporter authenticates with its own ServiceAccount
		// identity and assumes this role.
		role_arn              = {{ .S3.RoleARN | quote }}
{{- end }}
		compression           = "gzip"
		unique_key_func_name  = "uuidv7"
		// Partition keys are built from upload time in the pod's local zone unless pinned,
		// so leaving this unset makes partitioning depend on the pod.
		s3_partition_timezone = "UTC"
		retry_max_attempts    = {{ $.RetryMaxAttempts }}
		retry_max_backoff     = "{{ $.RetryMaxBackoff }}"
	}
}
{{- end }}
