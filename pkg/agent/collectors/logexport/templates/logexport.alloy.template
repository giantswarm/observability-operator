// This file was generated by observability-operator.
//
// Receives Loki push requests mirrored off the write path by an Envoy
// HTTPRequestMirrorFilter and archives the selected lines to object storage.
//
// Requires --stability.level=experimental: otelcol.exporter.awss3 is experimental
// and otelcol.storage.file is in public preview.

loki.source.api "mirror" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = 3100
	}
	forward_to = [loki.process.select.receiver]
}

loki.process "select" {
	// Selection is expressed as a DROP of the negated selector. `stage.match` with
	// the default action = "keep" does NOT drop non-matching entries -- it only
	// gates its nested stages -- and it fails validation without one. Emitting one
	// drop stage per negated term composes as an AND of keeps.
{{- range .DropSelectors }}
	stage.match {
		selector            = {{ . | quote }}
		action              = "drop"
		drop_counter_reason = "not_selected"
	}
{{- end }}

	forward_to = [otelcol.receiver.loki.to_s3.receiver]
}

otelcol.receiver.loki "to_s3" {
	output {
		logs = [otelcol.processor.transform.inject.input]
	}
}

// A Kubernetes audit event carries no cluster identifier of its own, and the
// `body` marshaler writes only the log line, dropping every Loki label. Without
// this the archive cannot be attributed to a cluster.
otelcol.processor.transform "inject" {
	error_mode = "ignore"

	log_statements {
		context = "log"

		statements = [
			`set(body, Concat([Substring(body, 0, Len(body) - 1), ",\"gs_cluster_id\":\"", attributes["cluster_id"], "\"}"], ""))`,
		]
	}

	output {
		logs = [otelcol.exporter.awss3.customer.input]
	}
}

otelcol.storage.file "wal" {
	directory = "/var/lib/alloy/wal"
}

otelcol.exporter.awss3 "customer" {
	// This operator's awss3 exporter does not expose retry_on_failure and it is
	// disabled, so `timeout` is the durability window: an object-store outage
	// longer than this loses data permanently.
	timeout = "{{ .Timeout }}"

	marshaler {
		// Raw log lines, newline-delimited -- directly queryable as NDJSON.
		type = "body"
	}

	sending_queue {
		enabled = true
		storage = otelcol.storage.file.wal.handler

		// The queue sits before the batcher and holds one entry per Loki entry.
		// The defaults (sizer = "requests", queue_size = 1000, block_on_overflow =
		// false) are well under a second of buffer at installation scale and drop
		// silently, visible only in otelcol_exporter_enqueue_failed_log_records_total.
		sizer             = "items"
		queue_size        = {{ .QueueSize }}
		block_on_overflow = true
		num_consumers     = 4

		// Mandatory. otelcol.receiver.loki calls ConsumeLogs once per entry, so
		// without batching every single log line becomes its own object.
		batch {
			sizer         = "items"
			min_size      = {{ .BatchMinSize }}
			max_size      = {{ .BatchMaxSize }}
			flush_timeout = "{{ .BatchFlushTimeout }}"
		}
	}

	s3_uploader {
		region                = {{ .Region | quote }}
		s3_bucket             = {{ .Bucket | quote }}
		s3_prefix             = {{ .Prefix | quote }}
{{- if .Endpoint }}
		endpoint              = {{ .Endpoint | quote }}
{{- end }}
{{- if .ForcePathStyle }}
		s3_force_path_style   = true
{{- end }}
		compression           = "gzip"
		unique_key_func_name  = "uuidv7"
		// Partition keys are built from upload time in the pod's local zone unless
		// pinned, so leaving this unset makes partitioning depend on the pod.
		s3_partition_timezone = "UTC"
		retry_max_attempts    = 10
		retry_max_backoff     = "5m"
	}
}
