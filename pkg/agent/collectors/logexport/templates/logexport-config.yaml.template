# This file was generated by observability-operator.
# It configures Alloy to archive audit and Teleport logs to object storage.
#
# - configMap is generated from logexport.alloy.template and passed as a string
#   here; Alloy's chart creates the ConfigMap from it.
# - Alloy runs as a statefulset because otelcol.storage.file needs per-replica
#   persistent storage: it is the write-ahead log that carries buffered records
#   through an object-store outage and across a pod restart.
# - alloy.enabled overrides the `false` shipped by management-cluster-bases
#   collections, which is what keeps this app inert on installations that have not
#   enabled log export.
alloy:
  enabled: true

  controller:
    type: statefulset
    replicas: {{ .Replicas }}
    volumeClaimTemplates:
      - metadata:
          name: wal
        spec:
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              # Size for rate x timeout, not for throughput: this only has to hold
              # what accumulates while the destination is unavailable.
              storage: {{ .WALSize | quote }}

  alloy:
    # otelcol.exporter.awss3 is experimental and otelcol.storage.file is in public
    # preview; Alloy refuses to load the config without this.
    stabilityLevel: experimental

    resources:
      requests:
        cpu: {{ .ResourcesRequestsCPU | quote }}
        memory: {{ .ResourcesRequestsMemory | quote }}
      limits:
        cpu: {{ .ResourcesLimitsCPU | quote }}
        memory: {{ .ResourcesLimitsMemory | quote }}

    mounts:
      extra:
        - name: wal
          mountPath: /var/lib/alloy

    configMap:
      create: true
      content: |-
        {{ .AlloyConfig | nindent 8 | replace "        \n" "" | trim }}

    # The object store credentials themselves are NOT here: they arrive as a
    # separate valuesFrom Secret rendered by pkg/agent/common/secret.go, which
    # alloy-app turns into a Secret named after the release.
    #
    # That Secret has to reach the container as environment variables, because the
    # awss3 exporter has no credential fields -- it uses the AWS SDK's default
    # chain. This is unlike the other collectors, whose credentials are read from a
    # Secret at runtime by `remote.kubernetes.secret` and so never need to be in the
    # environment.
    #
    # optional: true so the release still starts when no credentials Secret exists,
    # which is the case when the destination is reached with IRSA instead.
    envFrom:
      - secretRef:
          name: {{ .ReleaseName }}
          optional: true

# Cilium denies all egress when the rules are empty, so the exporter needs explicit
# permission to reach DNS and the object store.
networkPolicy:
  flavor: cilium
  cilium:
    egress:
      - toEntities:
          - kube-apiserver
          - cluster
          - world
      - toEndpoints:
          - matchLabels:
              k8s-app: coredns
          - matchLabels:
              k8s-app: k8s-dns-node-cache
        toPorts:
          - ports:
              - port: "1053"
                protocol: UDP
              - port: "1053"
                protocol: TCP
              - port: "53"
                protocol: UDP
              - port: "53"
                protocol: TCP

kyvernoPolicyExceptions:
  enabled: true
