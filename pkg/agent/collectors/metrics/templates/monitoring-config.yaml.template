# This file was generated by observability-operator.
# It configures Alloy to be used as a monitoring agent.
# - configMap is generated from logging.alloy.template and passed as a string
#   here and will be created by Alloy's chart.
# - Alloy runs as a statefulset, with required tolerations in order to scrape metrics
networkPolicy:
  cilium:
    egress:
    - toEntities:
      - kube-apiserver
      - cluster
      - world
    - toEndpoints:
      - matchLabels:
          k8s-app: coredns
      - matchLabels:
          k8s-app: k8s-dns-node-cache
      toPorts:
      - ports:
        - port: "1053"
          protocol: UDP
        - port: "1053"
          protocol: TCP
        - port: "53"
          protocol: UDP
        - port: "53"
          protocol: TCP
    - toEndpoints:
      - matchLabels:
          app.kubernetes.io/instance: alloy-metrics
          app.kubernetes.io/name: alloy
      toPorts:
      - ports:
        - port: "12345"
          protocol: TCP
    ingress:
    - fromEndpoints:
      - matchLabels:
          app.kubernetes.io/instance: alloy-metrics
          app.kubernetes.io/name: alloy
      toPorts:
      - ports:
        - port: "12345"
          protocol: TCP
# Token Secret the kube-prometheus-stack control-plane ServiceMonitors authenticate with.
serviceAccountTokenSecret:
  enabled: true
{{- if .IsSupportingMimirRulesLivenessProbe }}
# Script restarting Alloy when a mimir.rules.kubernetes component stays unhealthy while
# its Mimir ruler answers 200, working around https://github.com/grafana/alloy/pull/6339.
# The chart renders it as the {{ .AlloyAppName }}-mimir-rules-liveness-probe ConfigMap,
# mounted and run by the liveness probe below.
mimirRulesLivenessProbe:
  enabled: true
{{- end }}
alloy:
  alloy:
    clustering:
      enabled: true
    configMap:
      create: true
      content: |-
        {{ .AlloyConfig | nindent 8 }}
    # We decided to configure the alloy-metrics resources as such after some investigation done https://github.com/giantswarm/giantswarm/issues/32655#issuecomment-2729636063
    resources:
      limits:
        cpu: 100m
        memory: 768Mi
      requests:
        cpu: 25m
        memory: 512Mi
    ## Needed to to be able to support ScrapeConfig CRs
    stabilityLevel: experimental
    {{- if .IsSupportingMimirRulesLivenessProbe }}
    mounts:
      extra:
      # Repeated from the chart defaults: Helm replaces this list, it does not merge it.
      - name: alloy-tmp
        mountPath: /tmp/alloy
      - name: mimir-rules-liveness-probe
        mountPath: /etc/mimir-rules-liveness-probe
        readOnly: true
    livenessProbe:
      exec:
        command:
        - bash
        - /etc/mimir-rules-liveness-probe/mimir-rules-liveness-probe.sh
      initialDelaySeconds: 60
      periodSeconds: 60
      timeoutSeconds: 60
      failureThreshold: 3
    # Credentials the mimir.rules.kubernetes liveness probe authenticates to the
    # Mimir ruler with. Without them a Mimir behind a gateway answers 401 whether
    # its ruler is up or down, and the probe cannot tell an outage from the bug
    # it works around, so it never restarts Alloy.
    extraEnv:
    - name: MIMIR_USERNAME
      valueFrom:
        secretKeyRef:
          name: {{ .AlloySecretName }}
          key: {{ .MimirUsernameKey }}
          optional: true
    - name: MIMIR_PASSWORD
      valueFrom:
        secretKeyRef:
          name: {{ .AlloySecretName }}
          key: {{ .MimirPasswordKey }}
          optional: true
    {{- end }}
  controller:
    type: statefulset
    replicas: {{ .Replicas }}
    priorityClassName: {{ .PriorityClassName }}
    {{- if .IsSupportingMimirRulesLivenessProbe }}
    volumes:
      extra:
      # Repeated from the chart defaults: Helm replaces this list, it does not merge it.
      - name: alloy-tmp
        emptyDir: {}
      - name: mimir-rules-liveness-probe
        configMap:
          name: {{ .AlloyAppName }}-mimir-rules-liveness-probe
    {{- end }}
  crds:
    create: false
  affinity:
    nodeAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
      - preference:
          matchExpressions:
          - key: karpenter.sh/capacity-type
            operator: NotIn
            values:
            - spot
        weight: 100
    podAntiAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
      - podAffinityTerm:
          labelSelector:
            matchExpressions:
            - key: app.kubernetes.io/name
              operator: In
              values:
              - alloy
          topologyKey: kubernetes.io/hostname
        weight: 50

# We decided to configure the alloy-metrics vertical pod autoscaler as such after some investigation done https://github.com/giantswarm/giantswarm/issues/32655#issuecomment-2729636063
verticalPodAutoscaler:
  enabled: true
  resourcePolicy:
    containerPolicies:
    - containerName: alloy
      controlledResources:
      - memory
      - cpu
      controlledValues: "RequestsAndLimits"
      maxAllowed:
        cpu: 500m
        memory: 12Gi
      minAllowed:
        cpu: 25m
        memory: 512Mi
