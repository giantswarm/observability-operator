{{/*
  Alertmanager >= v0.30 parses each rendered detail as YAML and sends it as structured
  JSON unless the parse fails. We want the parse to fail, so this block is sent verbatim.
  Things to avoid:
  - Using a colon in the header (e.g. "Alerts:") because it will be interpreted as a key/value pair.
  - Using '---' because it will be interpreted as a YAML document separator.
*/}}
{{ define "pagerduty.default.description" -}}
Alerts 🔥
{{ range .Alerts.Firing }}  {{ if .Labels.instance }}{{ .Labels.instance }}: {{ end }}{{ .Annotations.description }}
{{ end }}
